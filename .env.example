# .env.example — required environment variables for Daily Dashboard
# Copy this file to .env.local and fill in real values before running locally.

# ── Google OAuth2 ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── CORS ──────────────────────────────────────────────────────────
# Allowed origin for API responses. Set to your production URL.
# If empty, the request Origin header is echoed back (permissive — not for production).
ALLOWED_ORIGIN=https://your-app.vercel.app

# ── Session ───────────────────────────────────────────────────────
# Secret used to sign the session cookie (min 32 chars, random string).
SESSION_SECRET=replace-with-a-long-random-string
